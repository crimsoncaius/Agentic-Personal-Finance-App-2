      "expected_has_entries": true,
      "description": "Basic expense write operation"
    },
    {
      "id": "write_2",
      "query": "earned $1000 salary today",
      "expected_tool_calls": ["create_entry"],
      "expected_has_entries": true,
      "description": "Income write operation"
    },
    {
      "id": "write_3",
      "query": "bought groceries for $75.50 at Whole Foods on Monday",
      "expected_tool_calls": ["create_entry"],
      "expected_has_entries": true,
      "description": "Detailed expense with store and specific date"
    },
    {
      "id": "write_4",
      "query": "bought $30 worth of groceries yesterday",
      "expected_tool_calls": ["create_entry"],
      "expected_has_entries": true,
      "description": "Yesterday date reference"
    },
    {
      "id": "aggregate_1",
      "query": "what's my total spending this month?",
      "expected_tool_calls": ["aggregate_entries"],
      "expected_has_entries": false,
      "description": "Sum aggregation for expenses"
    },
    {
      "id": "aggregate_3",
      "query": "what was my highest expense?",
      "expected_tool_calls": ["aggregate_entries"],
      "expected_has_entries": true,
      "description": "Max aggregation - may include entry details"
    },
    {
      "id": "update_1",
      "messages": [
        { "role": "user", "content": "show my recent expenses" },
        { "role": "user", "content": "change the first one to $50" }
      ],
      "expected_tool_calls": ["fetch_entries", "update_entry"],
      "expected_has_entries": true,
      "description": "Multi-message: fetch then update"
    },
    {
      "id": "update_2",
      "messages": [
        { "role": "user", "content": "what was my highest expense?" },
        {
          "role": "user",
          "content": "update its description to 'Holiday shopping'"
        }
      ],
      "expected_tool_calls": ["aggregate_entries", "update_entry"],
      "expected_has_entries": true,
      "description": "Multi-message: aggregate max then update"
    },
