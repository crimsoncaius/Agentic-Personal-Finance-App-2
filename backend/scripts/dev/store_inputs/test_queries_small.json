      "description": "Aggregate query - asking for total amount, not list"
    },
    {
      "id": "read_3",
      "query": "show me all income entries from last week over $500",
      "expected_tool_calls": ["fetch_entries"],
      "expected_has_entries": true,
      "description": "Complex read with multiple filters"
    },
    {
      "id": "read_4",
      "query": "list my groceries purchases",
      "expected_tool_calls": ["fetch_entries"],
      "expected_has_entries": true,
      "description": "Read with category filter"
    },
    {
      "id": "write_1",
      "query": "spent $20 on coffee",
