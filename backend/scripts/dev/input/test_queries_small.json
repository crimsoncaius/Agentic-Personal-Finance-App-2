      "query": "money stuff",
      "expected_pathway": "router -> unsure -> end",
      "description": "Ambiguous query that should trigger unsure pathway"
    },
    {
      "id": "complex_read",
      "query": "show me all income entries from last week over $500",
      "expected_pathway": "router -> read -> end",
      "description": "Complex read with multiple filters"
    },
    {
      "id": "complex_write",
      "query": "bought groceries for $75.50 at Whole Foods on Monday",
