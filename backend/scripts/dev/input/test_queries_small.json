      "description": "Detailed expense with store and amount"
    },
    {
      "id": "date_relative_today",
      "query": "spent $25 on lunch today",
      "expected_pathway": "router -> write -> end",
      "description": "Today date reference"
    },
    {
      "id": "date_relative_yesterday",
      "query": "bought $30 worth of groceries yesterday",
      "expected_pathway": "router -> write -> end",
      "description": "Yesterday date reference"
    },
    {
      "id": "category_food_variation",
      "query": "spent $25 on food at McDonald's",
