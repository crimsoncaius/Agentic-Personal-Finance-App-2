{
  "name": "@finance-app/shared",
  "version": "1.0.0",
  "description": "Shared types, services, and utilities for Personal Finance App",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./services/storage": {
