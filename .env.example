# Environment Configuration (development, production)
ENVIRONMENT=development

# Production Supabase Configuration
SUPABASE_URL_PROD=your-production-supabase-url
SUPABASE_KEY_PROD=your-production-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY_PROD=your-production-supabase-service-role-key

# Development Supabase Configuration
SUPABASE_URL_DEV=your-dev-supabase-url
SUPABASE_KEY_DEV=your-dev-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY_DEV=your-dev-supabase-service-role-key

# LLM Configuration (choose one)
OPENAI_API_KEY=your-openai-api-key

# Langfuse for observability
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Redis Configuration
# Local development (Docker): redis://localhost:6379
# Production (Railway): REDIS_URL will be auto-injected by Railway Redis plugin
REDIS_URL=redis://localhost:6379

# Test User ID
TEST_USER_ID=your-test-user-id
